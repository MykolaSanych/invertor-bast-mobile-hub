<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="#E60E1330"
                android:centerColor="#E6161C42"
                android:endColor="#E60B0F24"
                android:type="linear" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#00000000" />
            <stroke
                android:width="1.4dp"
                android:color="#8000D4FF" />
        </shape>
    </item>
</layer-list>
