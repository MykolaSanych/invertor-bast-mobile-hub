<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="#E6132049"
                android:centerColor="#E61C2454"
                android:endColor="#E60E1230"
                android:type="linear" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#00000000" />
            <stroke
                android:width="3dp"
                android:color="#E600D4FF" />
        </shape>
    </item>

    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="#00000000" />
            <stroke
                android:width="1.4dp"
                android:color="#B37DAFFF" />
        </shape>
    </item>
</layer-list>
